# Copy to app/.env (git-ignored). Everything EXPO_PUBLIC_* is bundled into the app and readable by anyone:
# NEVER put the Gemini key or the Supabase service-role key here.

# Leave the two Supabase values empty to run the app on built-in mock data (no backend needed).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Render URL, or http://<your-laptop-LAN-IP>:3000 when running the server locally (not localhost: the phone is another device).
EXPO_PUBLIC_API_URL=https://YOUR-APP.onrender.com

# Must match EVENT_ID in server/.env (the seed script creates this id).
EXPO_PUBLIC_EVENT_ID=00000000-0000-4000-8000-000000000001

# Force mock data even when Supabase is configured.
EXPO_PUBLIC_USE_MOCKS=false
