# Copy to server/.env (git-ignored) and fill in. Never commit real values.

# Google AI Studio -> Get API key. Leave empty to run in cache-only mode (no Gemini calls).
GEMINI_API_KEY=
# Check the current model list in AI Studio and paste exact names here.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.7-flash

# Supabase -> Project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fixed id created by the seed script. Must match EXPO_PUBLIC_EVENT_ID in app/.env
EVENT_ID=00000000-0000-4000-8000-000000000001

PORT=3000
# Set to "off" to stop the Open-Meteo poller (e.g. while running tests)
WEATHER_POLL=on
